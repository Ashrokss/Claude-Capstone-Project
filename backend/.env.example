# Environment Configuration for VeriClaim AI MVP Backend
# Copy this file to .env and fill in the actual values

# API Keys for AI Services (Required)
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Supabase Configuration (Required)
# SUPABASE_URL and SUPABASE_KEY (the anon key) are the only two that may ever
# reach the browser. The rest are backend-only secrets.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Secret. Used to verify access tokens.
# Authenticated routes reject every request while this is unset.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Project Settings -> Database -> Connection string.
# Port 5432 is the direct connection; port 6543 is the transaction pooler.
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# Application Settings
DEMO_MODE=
APP_NAME=
APP_VERSION=
DEBUG=

# Server Configuration
HOST=
PORT=
RELOAD=

# Logging
LOG_LEVEL=

# CORS Configuration
FRONTEND_URL=
# Optional comma-separated extra browser origins (preview/staging domains).
EXTRA_CORS_ORIGINS=

# JWT Configuration
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# File Storage
MAX_IMAGE_SIZE_MB=
MAX_DOCUMENT_SIZE_MB=
ALLOWED_IMAGE_FORMATS=
ALLOWED_DOCUMENT_FORMATS=

# AI Processing
AI_REQUEST_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
# Ceiling for one whole analysis run, which makes six or more provider calls.
AI_JOB_TIMEOUT_SECONDS=
