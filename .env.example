# VeriClaim — one configuration file for both services.
#
# Copy to .env and fill in. This is the single source of configuration:
#   * docker compose reads it automatically
#   * the backend reads it directly, from any working directory
#   * the frontend reads it for `npm run dev` and `npm run build`
#
# ---------------------------------------------------------------------------
# The one rule that matters
# ---------------------------------------------------------------------------
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle and is
# public forever. Everything else stays server-side: docker-compose.yml passes
# variables to each container by name, so the frontend container is never given
# the service role key, the JWT secret, or the AI keys. Do not add a
# NEXT_PUBLIC_ prefix to a secret to "make it work" in the browser — if the
# browser needs it, it is not a secret.


# ===========================================================================
# Browser-visible — public by design
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key, never the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must be reachable from your browser, not from inside the compose network:
# the requests are made by JavaScript in the browser, which cannot resolve the
# service name `backend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to false to close registration, as the deployed demo does.
NEXT_PUBLIC_ALLOW_SIGNUP=true


# ===========================================================================
# Supabase — backend only
# ===========================================================================
SUPABASE_URL=
# The publishable key again, under the name the backend expects.
SUPABASE_KEY=
# Secret. Settings -> API Keys -> Secret keys.
SUPABASE_SERVICE_ROLE_KEY=
# Secret. Settings -> JWT Keys. Authenticated routes reject every request while
# this is unset.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Settings -> Connect -> Session pooler. On the free tier the direct connection
# is IPv6-only and will time out from most networks.
DATABASE_URL=


# ===========================================================================
# AI providers — backend only, both secret
# ===========================================================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
# Ceiling for one whole analysis run, which makes six or more provider calls.
# An observed run took 304s; the old 300s limit killed it seconds from
# completion and then retried the lot.
AI_JOB_TIMEOUT_SECONDS=900


# ===========================================================================
# Application — backend only
# ===========================================================================
APP_NAME=VeriClaim AI MVP
APP_VERSION=0.1.0
DEMO_MODE=false
DEBUG=false
LOG_LEVEL=INFO

# Its own setting, and off by default. Tied to DEBUG it once wrote claimant
# names, emails and phone numbers into the log file.
SQL_ECHO=false

HOST=0.0.0.0
PORT=8000
RELOAD=false

# The browser origin allowed by CORS. Not the frontend container's hostname —
# same reason as NEXT_PUBLIC_API_URL above.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra browser origins (preview/staging domains).
EXTRA_CORS_ORIGINS=

# Secret. Generate a fresh one per environment.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png
ALLOWED_DOCUMENT_FORMATS=pdf,jpg,jpeg,png


# ===========================================================================
# Host port mappings — docker compose only
# ===========================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
