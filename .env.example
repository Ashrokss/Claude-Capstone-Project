# Copy to .env and fill in from your Supabase project.
# Read automatically by docker compose. These three are the frontend's
# browser-visible values — the publishable key is public by design, so nothing
# secret belongs in this file. Backend secrets stay in backend/.env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Must be reachable from your browser, not from inside the network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host port mappings, change if these clash with something already running.
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
